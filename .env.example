# uca.net — variables de entorno (PART 20 §20.6).
# Copiá este archivo a .env.local y completá los valores. NUNCA commitees valores reales.

# --- Supabase (proyecto de producción o el stack local de `supabase start`) ---
# Local: http://127.0.0.1:54321  ·  Prod: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clave anónima. Es pública por diseño: la seguridad es RLS, no esta clave (D5).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role. SOLO la leen /api/cron/* y los scripts de admin (D14.3).
# Ausente en Preview. Nunca se importa desde código del request path.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sitio ---
# URL canónica absoluta, sin barra final. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cron (Vercel inyecta el header Authorization: Bearer $CRON_SECRET) ---
CRON_SECRET=

# --- Cloudflare R2 (archivos de recursos, §0.5-R17). Solo servidor. ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Opcional: endpoint S3 explícito. Por defecto https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# --- Sentry (opcional en local) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Solo GitHub Actions (nunca en Vercel) ---
# SUPABASE_DB_URL=postgresql://...   # migraciones y backups
# SUPABASE_ACCESS_TOKEN=...
